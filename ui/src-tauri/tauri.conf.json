{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Click",
  "version": "1.0.0",
  "identifier": "com.hunter.click",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "咔哒 Clack",
        "width": 400,
        "height": 576,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "HUNTER",
    "copyright": "© 2026 HunterLies",
    "shortDescription": "咔哒 Clack · 运行库合集",
    "longDescription": "单文件运行库合集：一键补齐 Microsoft Visual C++ / Visual Basic / C Runtime 等运行库。",
    "resources": { "../../payload": "payload" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
